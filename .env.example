# Photography Pixel — environment variables
# Copy to .dev.vars for local development (wrangler pages dev)
# and set the same values as Cloudflare Pages "environment variables"
# in the production deployment (Settings → Environment variables).

# Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=

# Coordinator account (RBAC test / second staff user)
INITIAL_COORDINATOR_EMAIL=
INITIAL_COORDINATOR_PASSWORD=

# Canonical origin used when building private links (falls back to the
# request origin when unset). Local dev: http://localhost:8788
SITE_URL=

# Shared secret for the scheduled cleanup worker -> /__cleanup endpoint.
# Generate a long random value; the same value must be configured as the
# worker's CLEANUP_SECRET secret.
CLEANUP_SECRET=

# Optional: short-lived presigned download URLs for private R2 originals.
# When unset, downloads stream through the authorized Pages Function (still
# authenticated, just not a direct R2 redirect).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto